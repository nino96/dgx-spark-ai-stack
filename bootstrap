#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/.venv"

if [[ "$(uname -m)" != "aarch64" ]]; then
    echo "bootstrap: expected aarch64; this repository targets GB10 systems" >&2
    exit 1
fi
if [[ ! -r /etc/dgx-release ]]; then
    echo "bootstrap: /etc/dgx-release is missing; recover/update DGX OS first" >&2
    exit 1
fi
if ! python3 -m venv "$VENV" 2>/dev/null; then
    echo "Python venv support is missing; installing python3-venv."
    sudo apt-get update
    sudo apt-get install -y python3-venv
    python3 -m venv "$VENV"
fi

"$VENV/bin/python" -m pip install --upgrade "pip==25.1.1"
"$VENV/bin/python" -m pip install --requirement "$ROOT/ansible/requirements.txt"

echo
echo "Bootstrap complete. Next:"
echo "  bin/stack secrets-init --import-hf-token"
echo "  bin/stack migrate        # only on the existing configured GX10"
echo "  bin/stack apply"
