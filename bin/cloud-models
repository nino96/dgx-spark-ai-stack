#!/usr/bin/env python3
"""List the selected OpenRouter portfolio or compare it with the live catalog."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
import urllib.error
import urllib.request


ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "config" / "cloud-models.yaml"
CATALOG_URL = "https://openrouter.ai/api/v1/models"


def load(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def price(raw: str) -> float:
    return float(raw) * 1_000_000


def list_models(config: dict) -> int:
    print(f"Selected {config['selected_on']} — {config['pricing_unit']}")
    for model in config["models"]:
        print(
            f"{model['name']:<20} {model['openrouter_id']:<42} "
            f"${model['input_usd_per_million']:.3f} in / "
            f"${model['output_usd_per_million']:.3f} out — {model['purpose']}"
        )
    return 0


def check_models(config: dict) -> int:
    try:
        with urllib.request.urlopen(CATALOG_URL, timeout=30) as response:
            live = {item["id"]: item for item in json.load(response)["data"]}
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as error:
        print(f"cloud-models: catalog request failed: {error}", file=sys.stderr)
        return 2

    failed = False
    for selected in config["models"]:
        current = live.get(selected["openrouter_id"])
        if current is None:
            print(f"MISSING {selected['name']}: {selected['openrouter_id']}")
            failed = True
            continue
        current_input = price(current["pricing"]["prompt"])
        current_output = price(current["pricing"]["completion"])
        changes: list[str] = []
        if current.get("canonical_slug") != selected["canonical_slug"]:
            changes.append(f"canonical={current.get('canonical_slug')}")
            failed = True
        if abs(current_input - selected["input_usd_per_million"]) > 1e-9:
            changes.append(f"input=${current_input:.3f}/M")
        if abs(current_output - selected["output_usd_per_million"]) > 1e-9:
            changes.append(f"output=${current_output:.3f}/M")
        parameters = set(current.get("supported_parameters") or [])
        if not {"tools", "tool_choice", "structured_outputs"} <= parameters:
            changes.append("tool/structured-output support regressed")
            failed = True
        marker = "CHANGED" if changes else "OK"
        print(f"{marker:<7} {selected['name']}: {', '.join(changes) or selected['openrouter_id']}")
    return 1 if failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("list", "check"), nargs="?", default="list")
    args = parser.parse_args()
    config = load(CONFIG)
    return list_models(config) if args.command == "list" else check_models(config)


if __name__ == "__main__":
    raise SystemExit(main())
