#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_ROOT="${SPARK_AI_DATA_ROOT:-$HOME/ai-data}"
SECRETS_FILE="${SPARK_AI_SECRETS_FILE:-$HOME/.config/spark-ai-stack/secrets.env}"
VENV="$ROOT/.venv"
INVENTORY="$ROOT/ansible/inventory/hosts.yml"
COMPOSE=(docker compose --project-name spark-ai-stack --project-directory "$ROOT/compose" --file "$ROOT/compose/compose.yml")
VLLM_BASE="nvcr.io/nvidia/vllm:26.06-py3@sha256:47539d1e9a826506a1ff4536fe507d7688d453c07fe8a2325e96bcc9556b279a"

usage() {
    cat <<'EOF'
Usage: bin/stack COMMAND [options]

Commands:
  apply                    Converge host, artifacts, and user services
  check                    Run Ansible in check mode
  secrets-init             Create/preserve the mode-0600 secrets file
  render-config            Regenerate least-privilege runtime config
  migrate                  Non-destructively adopt current GX10 artifacts
  core-up|core-down        Start/stop PostgreSQL, LiteLLM, Open WebUI, SearXNG
  core-restart             Restart core containers after config/secrets changes
  backup [DIRECTORY]       Create a private, checksummed application backup
  upgrade                  Backup, converge current pins, and run diagnostics
  status                   Show containers, units, routes, and models
  logs [SERVICE]           Follow core container logs
  tailscale-configure      Publish UI, /v1, and /search through Serve
  tailscale-routing ARGS   Opt in to subnet-router/exit-node replacement
  doctor [ARGS...]         Run bin/doctor
EOF
}

variant() {
    local vendor product
    vendor="$(tr -d '\0' </sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
    product="$(tr -d '\0' </sys/class/dmi/id/product_name 2>/dev/null || true)"
    if [[ "$vendor" == *ASUSTeK* && "$product" == *GX10* ]]; then
        printf '%s\n' asus_gx10
    elif [[ "$vendor" == *NVIDIA* && "$product" == *DGX*Spark* ]]; then
        printf '%s\n' nvidia_dgx_spark
    else
        printf '%s\n' unsupported
    fi
}

ansible_run() {
    [[ -x "$VENV/bin/ansible-playbook" ]] || {
        echo "stack: Ansible environment missing; run ./bootstrap first" >&2
        exit 1
    }
    "$VENV/bin/ansible-playbook" \
        --inventory "$INVENTORY" \
        "$ROOT/ansible/site.yml" \
        --extra-vars "spark_ai_user=$USER spark_ai_repo=$ROOT spark_ai_variant=$(variant)" \
        "$@"
}

read_secret() {
    local key="$1" line
    [[ -f "$SECRETS_FILE" ]] || return 0
    while IFS= read -r line; do
        if [[ "$line" == "$key="* ]]; then
            printf '%s' "${line#*=}"
            return 0
        fi
    done <"$SECRETS_FILE"
}

secrets_init() {
    local import_hf=0
    if [[ "${1:-}" == "--import-hf-token" ]]; then
        import_hf=1
        shift
    fi
    [[ $# -eq 0 ]] || { echo "stack: unknown secrets-init option: $1" >&2; exit 2; }

    local lite searx hf pg_user pg_pass webui_secret webui_email
    local webui_password webui_name webui_url openai openrouter anthropic gemini temporary
    lite="$(read_secret LITELLM_MASTER_KEY)"
    searx="$(read_secret SEARXNG_SECRET)"
    hf="$(read_secret HF_TOKEN)"
    pg_user="$(read_secret PG_SUPERUSER)"
    pg_pass="$(read_secret PG_SUPERPASS)"
    webui_secret="$(read_secret WEBUI_SECRET_KEY)"
    webui_email="$(read_secret WEBUI_ADMIN_EMAIL)"
    webui_password="$(read_secret WEBUI_ADMIN_PASSWORD)"
    webui_name="$(read_secret WEBUI_ADMIN_NAME)"
    webui_url="$(read_secret WEBUI_URL)"
    openai="$(read_secret OPENAI_API_KEY)"
    openrouter="$(read_secret OPENROUTER_API_KEY)"
    anthropic="$(read_secret ANTHROPIC_API_KEY)"
    gemini="$(read_secret GEMINI_API_KEY)"
    local searx_base
    searx_base="$(read_secret SEARXNG_BASE_URL)"
    [[ -n "$searx_base" ]] || searx_base="http://127.0.0.1:8888/search/"
    [[ -n "$lite" && "$lite" != "replace-me" ]] || lite="sk-local-$(openssl rand -hex 32)"
    [[ -n "$searx" && "$searx" != "replace-me" ]] || searx="$(openssl rand -hex 32)"
    [[ -n "$pg_user" ]] || pg_user="sparkai"
    [[ -n "$pg_pass" && "$pg_pass" != "replace-me" ]] || pg_pass="$(openssl rand -hex 32)"
    [[ -n "$webui_secret" && "$webui_secret" != "replace-me" ]] || webui_secret="$(openssl rand -hex 32)"
    [[ -n "$webui_name" ]] || webui_name="Home Admin"
    [[ -n "$webui_url" ]] || webui_url="http://127.0.0.1:3000"
    if [[ "$import_hf" -eq 1 && -z "$hf" && -r "$HOME/.huggingface/token" ]]; then
        IFS= read -r hf <"$HOME/.huggingface/token"
    fi

    umask 077
    mkdir -p "$(dirname "$SECRETS_FILE")"
    temporary="$(mktemp "$(dirname "$SECRETS_FILE")/.secrets.env.XXXXXX")"
    trap 'rm -f -- "$temporary"' EXIT
    {
        printf 'LITELLM_MASTER_KEY=%s\n' "$lite"
        printf 'PG_SUPERUSER=%s\n' "$pg_user"
        printf 'PG_SUPERPASS=%s\n' "$pg_pass"
        printf 'WEBUI_SECRET_KEY=%s\n' "$webui_secret"
        printf 'WEBUI_ADMIN_EMAIL=%s\n' "$webui_email"
        printf 'WEBUI_ADMIN_PASSWORD=%s\n' "$webui_password"
        printf 'WEBUI_ADMIN_NAME=%s\n' "$webui_name"
        printf 'WEBUI_URL=%s\n' "$webui_url"
        printf 'OPENAI_API_KEY=%s\n' "$openai"
        printf 'OPENROUTER_API_KEY=%s\n' "$openrouter"
        printf 'ANTHROPIC_API_KEY=%s\n' "$anthropic"
        printf 'GEMINI_API_KEY=%s\n' "$gemini"
        printf 'SEARXNG_SECRET=%s\n' "$searx"
        printf 'SEARXNG_BASE_URL=%s\n' "$searx_base"
        printf 'HF_TOKEN=%s\n' "$hf"
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$SECRETS_FILE"
    trap - EXIT
    echo "Secrets ready at $SECRETS_FILE (0600). Values were not printed."
}

create_data_layout() {
    mkdir -p \
        "$DATA_ROOT/models/gguf" \
        "$DATA_ROOT/huggingface" \
        "$DATA_ROOT/src" \
        "$DATA_ROOT/builds" \
        "$DATA_ROOT/cache/searxng" \
        "$DATA_ROOT/postgres" \
        "$DATA_ROOT/open-webui" \
        "$DATA_ROOT/backups" \
        "$DATA_ROOT/state"
}

wait_for_docker() {
    local remaining=60
    while ! docker info >/dev/null 2>&1; do
        remaining=$((remaining - 1))
        if [[ "$remaining" -eq 0 ]]; then
            echo "stack: Docker did not become ready within 120 seconds" >&2
            return 1
        fi
        sleep 2
    done
}

adopt_file() {
    local source="$1" target="$2" expected="$3"
    if [[ -e "$target" ]]; then
        [[ "$(sha256sum "$target" | awk '{print $1}')" == "$expected" ]] || {
            echo "stack: existing target has the wrong checksum: $target" >&2
            return 1
        }
        echo "Already adopted and verified: $target"
        return 0
    fi
    [[ -f "$source" ]] || {
        echo "Not present; fetch later: $source"
        return 0
    }
    if ln -- "$source" "$target" 2>/dev/null; then
        echo "Hard-linked: $source -> $target"
    else
        cp --reflink=auto --sparse=always -- "$source" "$target"
        echo "Copied: $source -> $target"
    fi
    [[ "$(sha256sum "$target" | awk '{print $1}')" == "$expected" ]] || {
        echo "stack: checksum failed after adoption: $target" >&2
        return 1
    }
}

migrate() {
    create_data_layout
    local base drafter base_sha drafter_sha
    base="DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf"
    drafter="DSpark-drafter-Q2K-Q8-0731.gguf"
    base_sha="ca22ae2f838e14077c22bc1c1417b71b45b5e5a3687bd96c2ac6e17fdb6261c0"
    drafter_sha="8fa269560dc76fd73e4233ad9b1938b5f65dd363381fd9b1a5c6183f7d12d686"
    adopt_file "$HOME/gguf/$base" "$DATA_ROOT/models/gguf/$base" "$base_sha"
    adopt_file "$HOME/gguf/$drafter" "$DATA_ROOT/models/gguf/$drafter" "$drafter_sha"

    if docker volume inspect vllm-hf-cache >/dev/null 2>&1; then
        docker run --rm \
            --entrypoint /bin/bash \
            --mount type=volume,src=vllm-hf-cache,dst=/source,readonly \
            --mount type=bind,src="$DATA_ROOT/huggingface",dst=/dest \
            "$VLLM_BASE" \
            -lc 'cp -a /source/. /dest/'
        echo "Copied vllm-hf-cache into $DATA_ROOT/huggingface (source retained)."
    else
        echo "Docker volume vllm-hf-cache is absent; no cache export was needed."
    fi

    {
        printf 'migration_time=%s\n' "$(date --iso-8601=seconds)"
        printf 'source_gguf=%s\n' "$HOME/gguf"
        printf 'source_hf_volume=vllm-hf-cache\n'
        printf 'old_assets_retained=true\n'
        printf 'old_searx_secret_imported=false\n'
        printf 'notes_sanitized_into=docs/OPERATIONS.md\n'
    } >"$DATA_ROOT/state/migration-report.txt"
    echo "Migration complete. Existing units, containers, volumes, images, and paths were not removed."
}

urlencode() {
    jq -sRr @uri
}

render_config() {
    local secret lite hf searx_base pg_user pg_pass pg_pass_url
    local webui_secret webui_email webui_password webui_name webui_url
    local openai openrouter anthropic gemini temporary
    create_data_layout
    secret="$(read_secret SEARXNG_SECRET)"
    lite="$(read_secret LITELLM_MASTER_KEY)"
    hf="$(read_secret HF_TOKEN)"
    searx_base="$(read_secret SEARXNG_BASE_URL)"
    pg_user="$(read_secret PG_SUPERUSER)"
    pg_pass="$(read_secret PG_SUPERPASS)"
    webui_secret="$(read_secret WEBUI_SECRET_KEY)"
    webui_email="$(read_secret WEBUI_ADMIN_EMAIL)"
    webui_password="$(read_secret WEBUI_ADMIN_PASSWORD)"
    webui_name="$(read_secret WEBUI_ADMIN_NAME)"
    webui_url="$(read_secret WEBUI_URL)"
    openai="$(read_secret OPENAI_API_KEY)"
    openrouter="$(read_secret OPENROUTER_API_KEY)"
    anthropic="$(read_secret ANTHROPIC_API_KEY)"
    gemini="$(read_secret GEMINI_API_KEY)"
    [[ "$secret" =~ ^[A-Za-z0-9_-]{32,}$ ]] || {
        echo "stack: SEARXNG_SECRET must be at least 32 URL-safe characters" >&2
        exit 1
    }
    [[ "$lite" =~ ^[A-Za-z0-9_-]{32,}$ ]] || { echo "stack: LITELLM_MASTER_KEY is invalid" >&2; exit 1; }
    [[ "$pg_user" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "stack: PG_SUPERUSER is invalid" >&2; exit 1; }
    [[ -n "$pg_pass" ]] || { echo "stack: PG_SUPERPASS is empty" >&2; exit 1; }
    [[ ${#webui_secret} -ge 32 ]] || { echo "stack: WEBUI_SECRET_KEY must be at least 32 characters" >&2; exit 1; }
    [[ -n "$webui_url" ]] || { echo "stack: WEBUI_URL is empty" >&2; exit 1; }
    [[ -n "$searx_base" ]] || { echo "stack: SEARXNG_BASE_URL is empty" >&2; exit 1; }
    pg_pass_url="$(printf '%s' "$pg_pass" | urlencode)"
    umask 077
    temporary="$(mktemp "$DATA_ROOT/state/.searxng-settings.XXXXXX")"
    trap 'rm -f -- "$temporary"' RETURN
    sed "s/__SEARXNG_SECRET__/$secret/" "$ROOT/compose/searxng/settings.yml" >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/searxng-settings.yml"
    temporary="$(mktemp "$DATA_ROOT/state/.litellm-env.XXXXXX")"
    {
        printf 'LITELLM_MASTER_KEY=%s\n' "$lite"
        printf 'DATABASE_URL=postgresql://%s:%s@127.0.0.1:5432/litellm\n' "$pg_user" "$pg_pass_url"
        printf 'OPENAI_API_KEY=%s\n' "$openai"
        printf 'OPENROUTER_API_KEY=%s\n' "$openrouter"
        printf 'ANTHROPIC_API_KEY=%s\n' "$anthropic"
        printf 'GEMINI_API_KEY=%s\n' "$gemini"
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/litellm.env"
    temporary="$(mktemp "$DATA_ROOT/state/.searxng-env.XXXXXX")"
    printf 'SEARXNG_BASE_URL=%s\n' "$searx_base" >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/searxng.env"
    temporary="$(mktemp "$DATA_ROOT/state/.vllm-env.XXXXXX")"
    printf 'HF_TOKEN=%s\n' "$hf" >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/vllm.env"
    temporary="$(mktemp "$DATA_ROOT/state/.postgres-env.XXXXXX")"
    {
        printf 'POSTGRES_USER=%s\n' "$pg_user"
        printf 'POSTGRES_PASSWORD=%s\n' "$pg_pass"
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/postgres.env"
    temporary="$(mktemp "$DATA_ROOT/state/.open-webui-env.XXXXXX")"
    {
        printf 'WEBUI_URL=%s\n' "$webui_url"
        printf 'WEBUI_SECRET_KEY=%s\n' "$webui_secret"
        printf 'WEBUI_ADMIN_EMAIL=%s\n' "$webui_email"
        printf 'WEBUI_ADMIN_PASSWORD=%s\n' "$webui_password"
        printf 'WEBUI_ADMIN_NAME=%s\n' "$webui_name"
        printf 'HOST=127.0.0.1\n'
        printf 'PORT=3000\n'
        printf 'DATABASE_URL=postgresql://%s:%s@127.0.0.1:5432/openwebui\n' "$pg_user" "$pg_pass_url"
        printf 'OPENAI_API_BASE_URL=http://127.0.0.1:4000/v1\n'
        printf 'OPENAI_API_KEY=%s\n' "$lite"
        printf 'DEFAULT_USER_ROLE=pending\n'
        printf 'ENABLE_SIGNUP=False\n'
        printf 'ENABLE_ADMIN_CHAT_ACCESS=False\n'
        printf 'ENABLE_QUERIES_CACHE=True\n'
        printf 'WEB_LOADER_ENGINE=playwright\n'
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/open-webui.env"
    temporary="$(mktemp "$DATA_ROOT/state/.postgres-init.XXXXXX")"
    printf 'CREATE DATABASE openwebui;\nCREATE DATABASE litellm;\n' >"$temporary"
    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$DATA_ROOT/state/postgres-init.sql"
    trap - RETURN
}

update_secret_value() {
    local key="$1" value="$2" temporary
    umask 077
    temporary="$(mktemp "$(dirname "$SECRETS_FILE")/.secrets.env.XXXXXX")"
    awk -v key="$key" -v value="$value" 'BEGIN { found=0 } index($0, key "=") == 1 { print key "=" value; found=1; next } { print } END { if (!found) print key "=" value }' "$SECRETS_FILE" >"$temporary"
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$SECRETS_FILE"
}

core_up() {
    wait_for_docker
    render_config
    "$ROOT/bin/modelctl" init
    "${COMPOSE[@]}" up -d litellm open-webui searxng
}

tailscale_configure() {
    local replace=0 current
    if [[ "${1:-}" == "--replace" ]]; then
        replace=1
        shift
    fi
    [[ $# -eq 0 ]] || { echo "stack: unknown tailscale-configure option: $1" >&2; exit 2; }
    tailscale status >/dev/null
    create_data_layout
    current="$(tailscale serve status --json)"
    if [[ "$current" != "{}" && "$replace" -ne 1 ]]; then
        echo "stack: Tailscale Serve already has configuration." >&2
        echo "Inspect it, then rerun with --replace to back it up and replace it." >&2
        exit 1
    fi
    tailscale serve get-config >"$DATA_ROOT/state/tailscale-serve.previous.json" 2>/dev/null || true
    tailscale serve reset
    # Serve strips the mount prefix before proxying. Repeat it in the target so
    # public /v1/* and /search/* remain the same paths at each backend.
    tailscale serve --yes --bg http://127.0.0.1:3000
    tailscale serve --yes --bg --set-path=/v1 http://127.0.0.1:4000/v1
    tailscale serve --yes --bg --set-path=/search http://127.0.0.1:8888/search
    local dns_name
    dns_name="$(tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//')"
    [[ -n "$dns_name" && "$dns_name" != null ]] || { echo "stack: MagicDNS name is unavailable" >&2; exit 1; }
    update_secret_value SEARXNG_BASE_URL "https://$dns_name/search/"
    update_secret_value WEBUI_URL "https://$dns_name"
    render_config
    "${COMPOSE[@]}" up -d --force-recreate open-webui searxng
    tailscale serve status
    echo "Serve configured. Funnel was not enabled."
}

backup_stack() {
    local destination="${1:-$DATA_ROOT/backups/$(date +%Y%m%d-%H%M%S)}"
    [[ $# -le 1 ]] || { echo "stack: backup accepts at most one destination" >&2; exit 2; }
    [[ ! -e "$destination" ]] || { echo "stack: backup destination already exists: $destination" >&2; exit 1; }
    [[ -f "$SECRETS_FILE" ]] || { echo "stack: secrets file is missing: $SECRETS_FILE" >&2; exit 1; }
    local pg_user webui_was_running=0
    resume_webui() {
        if [[ "$webui_was_running" -eq 1 ]]; then
            docker start spark-ai-open-webui >/dev/null
        fi
    }
    pg_user="$(read_secret PG_SUPERUSER)"
    [[ -n "$pg_user" ]] || { echo "stack: PG_SUPERUSER is empty" >&2; exit 1; }
    docker inspect spark-ai-postgres >/dev/null 2>&1 || { echo "stack: PostgreSQL container is absent" >&2; exit 1; }
    umask 077
    mkdir -p "$destination/open-webui-data"
    if [[ "$(docker inspect --format '{{.State.Running}}' spark-ai-open-webui 2>/dev/null || true)" == true ]]; then
        docker stop spark-ai-open-webui >/dev/null
        webui_was_running=1
        trap resume_webui EXIT
    fi
    docker exec spark-ai-postgres pg_dump -U "$pg_user" --format=custom --no-owner --no-privileges openwebui >"$destination/openwebui.dump"
    docker exec spark-ai-postgres pg_dump -U "$pg_user" --format=custom --no-owner --no-privileges litellm >"$destination/litellm.dump"
    if docker inspect spark-ai-open-webui >/dev/null 2>&1; then
        docker cp spark-ai-open-webui:/app/backend/data/. "$destination/open-webui-data"
    fi
    install -m 0600 "$SECRETS_FILE" "$destination/secrets.env"
    install -m 0600 "$DATA_ROOT/state/litellm-config.yaml" "$destination/litellm-config.yaml"
    {
        printf 'created=%s\n' "$(date --iso-8601=seconds)"
        printf 'git_commit=%s\n' "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf unknown)"
        printf 'data_root=%s\n' "$DATA_ROOT"
        docker inspect --format '{{.Name}} {{.Config.Image}} {{.Image}}' \
            spark-ai-postgres spark-ai-litellm spark-ai-open-webui spark-ai-searxng 2>/dev/null || true
    } >"$destination/metadata.txt"
    (
        cd "$destination"
        find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum >SHA256SUMS
    )
    chmod -R go-rwx "$destination"
    if [[ "$webui_was_running" -eq 1 ]]; then
        docker start spark-ai-open-webui >/dev/null
        webui_was_running=0
        trap - EXIT
    fi
    printf '%s\n' "$destination"
}

upgrade_stack() {
    [[ $# -eq 0 ]] || { echo "stack: upgrade takes no options" >&2; exit 2; }
    echo "Running repository validation before changing services."
    "$ROOT/tests/static.sh"
    local backup_path
    backup_path="$(backup_stack)"
    echo "Pre-upgrade backup: $backup_path"
    echo "Pulling only the immutable image digests in the checked-out lockfile."
    "${COMPOSE[@]}" pull postgres litellm open-webui searxng
    "${COMPOSE[@]}" build vllm
    ansible_run
    "$ROOT/bin/dnsctl" update-active
    "$ROOT/bin/doctor"
    {
        printf 'completed=%s\n' "$(date --iso-8601=seconds)"
        printf 'git_commit=%s\n' "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf unknown)"
        printf 'backup=%s\n' "$backup_path"
    } >"$DATA_ROOT/state/last-upgrade.txt"
    echo "Upgrade completed. Reboot verification remains: bin/doctor --full"
}

tailscale_routing() {
    local cidr="" exit_node=0 disable=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lan-cidr)
                [[ $# -ge 2 ]] || { echo "stack: --lan-cidr requires a value" >&2; exit 2; }
                cidr="$2"
                shift 2
                ;;
            --exit-node) exit_node=1; shift ;;
            --disable) disable=1; shift ;;
            *) echo "Usage: bin/stack tailscale-routing --lan-cidr CIDR [--exit-node] | --disable" >&2; exit 2 ;;
        esac
    done
    if [[ "$disable" -eq 1 ]]; then
        sudo tailscale set --advertise-routes= --advertise-exit-node=false
        echo "Subnet and exit-node advertisements disabled on this node."
        return
    fi
    [[ "$cidr" =~ ^[0-9a-fA-F:.]+/[0-9]+$ ]] || { echo "stack: --lan-cidr must be an explicit CIDR" >&2; exit 2; }
    sudo install -m 0644 /dev/stdin /etc/sysctl.d/99-spark-ai-tailscale-routing.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF
    sudo sysctl --system >/dev/null
    local args=(
        set
        --accept-dns=false
        --accept-routes=false
        --advertise-routes="$cidr"
        --auto-update
        --netfilter-mode=on
        --operator="$USER"
        --snat-subnet-routes=true
    )
    if [[ "$exit_node" -eq 1 ]]; then
        args+=(--advertise-exit-node)
    else
        args+=(--advertise-exit-node=false)
    fi
    sudo tailscale "${args[@]}"
    tailscale get
    echo "Approve the new subnet route and/or exit node in the Tailscale admin console before retiring the HPT640."
}

command="${1:-}"
[[ -n "$command" ]] || { usage; exit 2; }
shift
case "$command" in
    apply) ansible_run "$@" ;;
    check) ansible_run --check --diff "$@" ;;
    secrets-init) secrets_init "$@" ;;
    render-config) [[ $# -eq 0 ]] || { usage; exit 2; }; render_config ;;
    migrate) [[ $# -eq 0 ]] || { usage; exit 2; }; migrate ;;
    core-up) [[ $# -eq 0 ]] || { usage; exit 2; }; core_up ;;
    core-down) [[ $# -eq 0 ]] || { usage; exit 2; }; "${COMPOSE[@]}" down ;;
    core-restart)
        [[ $# -eq 0 ]] || { usage; exit 2; }
        render_config
        "$ROOT/bin/modelctl" routes --no-restart
        "${COMPOSE[@]}" restart litellm open-webui searxng
        ;;
    backup) backup_stack "$@" ;;
    upgrade) upgrade_stack "$@" ;;
    status)
        [[ $# -eq 0 ]] || { usage; exit 2; }
        "${COMPOSE[@]}" ps
        systemctl --user --no-pager status spark-ai-core.service spark-ai-boot-model.service || true
        "$ROOT/bin/modelctl" status
        tailscale serve status || true
        ;;
    logs)
        service="${1:-litellm}"
        case "$service" in
            postgres) docker logs -f spark-ai-postgres ;;
            litellm) docker logs -f spark-ai-litellm ;;
            open-webui) docker logs -f spark-ai-open-webui ;;
            searxng) docker logs -f spark-ai-searxng ;;
            *) echo "stack: logs service must be postgres, litellm, open-webui, or searxng" >&2; exit 2 ;;
        esac
        ;;
    tailscale-configure) tailscale_configure "$@" ;;
    tailscale-routing) tailscale_routing "$@" ;;
    doctor) exec "$ROOT/bin/doctor" "$@" ;;
    help|-h|--help) usage ;;
    *) echo "stack: unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
