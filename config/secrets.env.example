# Copy to ~/.config/spark-ai-stack/secrets.env and chmod 0600.
# Generate long random values with: bin/stack secrets-init
LITELLM_MASTER_KEY=replace-me
SEARXNG_SECRET=replace-me
SEARXNG_BASE_URL=http://127.0.0.1:8888/search/
# Required for gated/private Hugging Face models; never commit it.
HF_TOKEN=
