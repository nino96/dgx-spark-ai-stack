def stop_backend_service(service: str) -> None:
    run(compose_argv("stop", service, profile="models"), check=False)


def cmd_backend_start(args: argparse.Namespace) -> int:
    """Start (or switch) the model in `args.model_id`'s slot.

    Sequence (docs/CONTRACTS.md §5): validate -> render override.yaml ->
    `compose up -d <service>` -> update active.json -> re-render
    litellm-config.yaml (file only; does NOT restart litellm — that is the
    separate `gateway-reload` verb, invoked explicitly by the caller).
    """
    with state_lock():
        cfg, backend, slot, served_name = resolve_for_backend_start(args.model_id, args.experimental)
        # Validate now so an unsafe catalog entry is rejected before any state
        # mutation happens.
        args_tokens = validate_args_tokens(cfg.get("args"), args.model_id)
        validate_environment(cfg.get("environment"), args.model_id)
        if backend == "llamacpp":
            build_llamacpp_argv(cfg, served_name, args_tokens)  # validate only
        elif backend == "vllm":
            build_vllm_argv(cfg, served_name)
        else:
            build_sglang_argv(cfg, served_name)

        active = load_active()
        host_port = SLOT_HOST_PORT[slot]
        service = service_for(backend, slot)

        # Single-occupancy per slot (host port) and per compose service
        # (container). Each (backend, slot) pair maps to its own service, so
        # e.g. a text model on vllm/primary and a vision model on
        # vllm-secondary can coexist. Stop whichever other active model
        # conflicts on either axis before starting this one.
        for other_id in list(active["active"].keys()):
            if other_id == args.model_id:
                continue
            other = active["active"][other_id]
            other_service = other.get("service") or service_for(
                other.get("backend", ""), other.get("slot", "primary")
            )
            if other.get("slot") == slot or other_service == service:
                stop_backend_service(other_service)
                del active["active"][other_id]

        active["active"][args.model_id] = {
            "slot": slot,
            "backend": backend,
            "service": service,
            "port": host_port,
            "served_model_name": served_name,
        }
        save_active(active)
        render_override(active)
        run(compose_argv("up", "-d", service, profile="models"))
        render_litellm_config(active)
    print(f"backend-start: {args.model_id} started (backend={backend}, slot={slot}, host_port={host_port})")
    print("Run 'sudo spark-ai-ctl gateway-reload' to point the gateway at it once healthy.")
    return 0


def cmd_backend_stop(args: argparse.Namespace) -> int:
    """Stop a model by id, or whichever model currently occupies `primary`/`secondary`.

    Also removes it from active.json and runs a full gateway-reload so the
    gateway stops routing to it.
    """
    with state_lock():
        active = load_active()
        target = args.target
        if target in SLOT_HOST_PORT:
            matches = [mid for mid, rec in active["active"].items() if rec.get("slot") == target]
            if not matches:
                raise SparkCtlError(f"no model is active in slot '{target}'")
            model_id = matches[0]
        else:
            model_id = target
            if model_id not in active["active"]:
                raise SparkCtlError(f"model '{model_id}' is not active")

        rec = active["active"][model_id]
        stop_backend_service(
            rec.get("service") or service_for(rec["backend"], rec.get("slot", "primary"))
        )
        del active["active"][model_id]
        save_active(active)
        render_override(active)
        render_litellm_config(active)
        run(compose_argv("up", "-d", "litellm"))
        run(compose_argv("restart", "litellm"))
    print(f"backend-stop: {model_id} stopped (was slot={rec['slot']}, backend={rec['backend']})")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    """Read-only: active.json + `docker compose ps`. Machine-readable on --json."""
    active = load_active()
    result = subprocess.run(
        compose_argv("ps", "--format", "json"), text=True, capture_output=True, check=False
    )
    ps_entries: list[Any] = []
    raw = (result.stdout or "").strip()
    if raw:
        try:
            parsed = json.loads(raw)
            ps_entries = parsed if isinstance(parsed, list) else [parsed]
        except json.JSONDecodeError:
            # Some compose versions emit NDJSON (one object per line).
            for line in raw.splitlines():
                line = line.strip()
                if not line:
                    continue
                with contextlib.suppress(json.JSONDecodeError):
                    ps_entries.append(json.loads(line))

    if args.json:
        payload = {"active": active["active"], "updated": active.get("updated"), "compose_ps": ps_entries}
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0

    print(f"active models (updated {active.get('updated')}):")
    if not active["active"]:
        print("  (none)")
    for model_id, rec in sorted(active["active"].items()):
        print(
            f"  {model_id:<28} slot={rec.get('slot'):<10} "
            f"backend={rec.get('backend'):<10} port={rec.get('port')}"
        )
    print()
    print("compose ps:")
    run(compose_argv("ps"), check=False)
    return 0


# --------------------------------------------------------------------------
# sync — the human trust gate (docs/CONTRACTS.md §2.2)
# --------------------------------------------------------------------------


def cmd_sync(args: argparse.Namespace) -> int:
    """Diff the repo's compose/catalog/template files against their
    /etc/spark-ai-stack copies, then — after an explicit human confirmation
    (or --yes) — copy them in and re-derive env.d. This is the ONLY verb that
    reads from the untrusted repository, and it is excluded from the NOPASSWD
    sudoers grant on purpose.
    """
    with state_lock():
        changes: list[tuple[Path, Path, str]] = []
        missing_sources: list[Path] = []

        for repo_path, etc_path in SYNC_MAP:
            if not repo_path.exists():
                missing_sources.append(repo_path)
                continue
            new_text = repo_path.read_text(encoding="utf-8")
            if etc_path.exists():
                old_text = etc_path.read_text(encoding="utf-8")
                if old_text == new_text:
                    print(f"=== {etc_path}: unchanged ===")
                    continue
                print(f"=== {etc_path}: changed ===")
                diff = difflib.unified_diff(
                    old_text.splitlines(keepends=True),
                    new_text.splitlines(keepends=True),
                    fromfile=str(etc_path),
                    tofile=str(repo_path),
                )
                sys.stdout.writelines(diff)
            else:
                print(f"=== {etc_path}: new file (source {repo_path}) ===")
            changes.append((repo_path, etc_path, new_text))

        if missing_sources:
            print("Skipped (not present in the repo yet):", file=sys.stderr)
            for path in missing_sources:
                print(f"  {path}", file=sys.stderr)

        if not changes:
            print("Nothing to sync.")
            return 0

        if not args.yes:
            if sys.stdin.isatty():
                answer = input("Apply? [y/N] ").strip().lower()
                if answer not in ("y", "yes"):
                    print("Aborted; no changes applied.")
                    return 1
            else:
                print(
                    "spark-ai-ctl: refusing to apply sync changes without --yes (not a tty)",
                    file=sys.stderr,
                )
                return 2

        for _repo_path, etc_path, new_text in changes:
            atomic_write(etc_path, new_text, 0o644)
            print(f"synced: {etc_path}")

        if SECRETS_FILE.exists():
            secret_values = parse_env_file(SECRETS_FILE)
            derive_env_d(secret_values)
            print("env.d/*.env re-derived from existing secrets.env")
        else:
            print(
                "secrets.env not found; run 'sudo spark-ai-ctl secrets-init' to create it",
                file=sys.stderr,
            )
    return 0


# --------------------------------------------------------------------------
# argparse — enumerated verbs and choices= only (docs/CONTRACTS.md §2.3)
# --------------------------------------------------------------------------


def build_parser(main_ids: list[str], experimental_ids: list[str]) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="spark-ai-ctl",
        description="Privileged control wrapper for spark-ai-stack (root-only).",
    )
    sub = parser.add_subparsers(dest="verb", required=True)

    for verb in (
        "core-up", "core-down", "core-restart", "core-ps",
        "gateway-reload",
        "monitoring-up", "monitoring-down",
        "utilities-up", "utilities-down",
        "secrets-init", "secrets-status",
    ):
        sub.add_parser(verb)

    start_parser = sub.add_parser("backend-start")
    start_choices = sorted(set(main_ids) | set(experimental_ids)) or None
    start_parser.add_argument(
        "model_id", choices=start_choices, metavar="MODEL_ID",
        help="model id from models.yaml (or experimental.yaml with --experimental)",
    )
    start_parser.add_argument(
        "--experimental", action="store_true",
        help="allow a model id defined only in experimental.yaml",
    )

    stop_parser = sub.add_parser("backend-stop")
    stop_choices = sorted(set(main_ids) | set(experimental_ids) | set(SLOT_HOST_PORT)) or None
    stop_parser.add_argument("target", choices=stop_choices, metavar="MODEL_ID_OR_SLOT")

    rotate_parser = sub.add_parser("secrets-rotate")
    rotate_parser.add_argument("key", choices=SECRET_KEYS, metavar="KEY")

    sync_parser = sub.add_parser("sync")
    sync_parser.add_argument("--yes", action="store_true", help="apply without an interactive confirm")

    status_parser = sub.add_parser("status")
    status_parser.add_argument("--json", action="store_true")

    return parser


HANDLERS = {
    "core-up": cmd_core_up,
    "core-down": cmd_core_down,
    "core-restart": cmd_core_restart,
    "core-ps": cmd_core_ps,
    "backend-start": cmd_backend_start,
    "backend-stop": cmd_backend_stop,
    "gateway-reload": cmd_gateway_reload,
    "monitoring-up": cmd_monitoring_up,
    "monitoring-down": cmd_monitoring_down,
    "utilities-up": cmd_utilities_up,
    "utilities-down": cmd_utilities_down,
    "secrets-init": cmd_secrets_init,
    "secrets-status": cmd_secrets_status,
    "secrets-rotate": cmd_secrets_rotate,
    "sync": cmd_sync,
    "status": cmd_status,
}


def main(argv: list[str] | None = None) -> int:
    if os.geteuid() != 0:
        print("spark-ai-ctl: refuses to run: must be root (invoke via sudo)", file=sys.stderr)
        return 1

    main_ids, experimental_ids = discover_catalog_ids()
    parser = build_parser(main_ids, experimental_ids)
    args = parser.parse_args(argv if argv is not None else sys.argv[1:])
    handler = HANDLERS[args.verb]

    try:
        return handler(args)
    except SparkCtlError as exc:
        print(f"spark-ai-ctl: {exc}", file=sys.stderr)
        return exc.exit_code
    except subprocess.CalledProcessError as exc:
        printable_cmd = " ".join(exc.cmd) if isinstance(exc.cmd, list) else str(exc.cmd)
        print(f"spark-ai-ctl: command failed ({exc.returncode}): {printable_cmd}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"spark-ai-ctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
