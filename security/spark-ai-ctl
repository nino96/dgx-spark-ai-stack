class SparkCtlError(Exception):
    """Base error for all user-facing failures. Caught in main(); never a traceback."""

    exit_code = 1


class CatalogError(SparkCtlError):
    """Raised when catalog content (models.yaml/experimental.yaml) is rejected as unsafe."""

    exit_code = 3


