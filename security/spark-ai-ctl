def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def ensure_dir(path: Path, mode: int) -> None:
    """Create `path` (and parents) if missing and force root:root ownership + mode.

    Idempotent and safe to call unconditionally: makes the wrapper self-healing
    even if bootstrap.sh has not (yet) created every directory.
    """
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, mode)
    os.chown(path, 0, 0)


def atomic_write(path: Path, content: str, mode: int) -> None:
    """Write `content` to `path` atomically: tmp file + fsync + rename, root:root owned."""
    ensure_dir(path.parent, 0o755)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp_path, mode)
        os.chown(tmp_path, 0, 0)
        os.replace(tmp_path, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp_path)
        raise


@contextlib.contextmanager
def state_lock():
    """Exclusive flock on /run/spark-ai-stack/lock, held for the duration of any
    state-mutating verb (docs/CONTRACTS.md §5: "All state-mutating verbs take
    an flock")."""
    ensure_dir(RUN_ROOT, 0o755)
    with open(LOCK_FILE, "a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def run(argv: list[str], *, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess:
    """subprocess wrapper: explicit argv list, shell=False, always."""
    return subprocess.run(argv, shell=False, check=check, text=True, capture_output=capture)


def compose_base_files() -> list[str]:
    files = [str(ETC_COMPOSE_FILE)]
    if ETC_MONITORING_FILE.exists():
        files.append(str(ETC_MONITORING_FILE))
    if OVERRIDE_FILE.exists():
        files.append(str(OVERRIDE_FILE))
    return files


def compose_argv(*verb_and_args: str, profile: str | None = None) -> list[str]:
    """Build a `docker compose` invocation per docs/CONTRACTS.md §4's fixed shape."""
    argv = ["docker", "compose", "--project-name", COMPOSE_PROJECT]
    for f in compose_base_files():
        argv += ["-f", f]
    if profile:
        argv += ["--profile", profile]
    argv += list(verb_and_args)
    return argv


def resolve_defined_services(hardcoded_names: list[str], *, profile: str | None = None) -> list[str]:
    """Intersect a hardcoded service-name list with what the current compose
    files actually define, preserving order. A name in `hardcoded_names` that
    isn't defined yet (e.g. `whisper`, pending an image pin) is skipped with a
    warning rather than making the whole verb fail with "no such service".
    """
    result = subprocess.run(
        compose_argv("config", "--services", profile=profile),
        text=True, capture_output=True, check=False,
    )
    if result.returncode != 0:
        # Can't discover services (e.g. compose files not synced yet); fall
        # back to the full hardcoded list and let docker compose report the
        # real error.
        return list(hardcoded_names)
    defined = {line.strip() for line in result.stdout.splitlines() if line.strip()}
    resolved = [name for name in hardcoded_names if name in defined]
    for missing in hardcoded_names:
        if missing not in defined:
            print(
                f"spark-ai-ctl: note: service '{missing}' is not defined in the "
                "current compose files yet; skipping it",
                file=sys.stderr,
            )
    return resolved


def parse_env_file(path: Path) -> dict[str, str]:
    """Minimal KEY=VALUE parser for the files this program itself writes.

    Not a general-purpose shell/env parser: comment lines start with '#',
    blank lines are ignored, and values are taken verbatim after the first
    '='. This is sufficient because secrets.env is authored exclusively by
    this program (render_secrets_file / secrets-rotate).
    """
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, _, value = stripped.partition("=")
        values[key.strip()] = value.strip()
    return values


