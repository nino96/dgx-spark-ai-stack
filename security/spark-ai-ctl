def service_for(backend: str, slot: str) -> str:
    """Compose service name for a (backend, slot) pair.

    Each slot needs its own container so that e.g. a text model (vllm,
    primary) and a vision model (vllm, secondary) can run concurrently.
    The secondary variants are separate skeleton services in compose.yml;
    sglang deliberately has no secondary variant.
    """
    if slot == "secondary":
        if backend == "sglang":
            raise CatalogError("sglang models support only the primary slot")
        return f"{backend}-secondary"
    return BACKEND_SERVICE_NAME[backend]

