def load_catalog(path: Path) -> dict[str, Any]:
    """Load and minimally validate a root-owned catalog file (yaml.safe_load only)."""
    if not path.exists():
        raise SparkCtlError(f"catalog file missing: {path} (run 'sudo spark-ai-ctl sync' first)")
    try:
        with path.open("r", encoding="utf-8") as handle:
            doc = yaml.safe_load(handle)
    except yaml.YAMLError as exc:
        raise SparkCtlError(f"failed to parse {path}: {exc}") from exc
    if not isinstance(doc, dict) or "models" not in doc or not isinstance(doc["models"], dict):
        raise SparkCtlError(f"{path} is not a valid catalog document (missing top-level 'models' mapping)")
    return doc


def discover_catalog_ids() -> tuple[list[str], list[str]]:
    """Best-effort model-id discovery used only to populate argparse `choices=`.

    Never raises: an unreadable/missing catalog just means argparse falls back
    to unrestricted string arguments for that catalog, and the real
    validation still happens in resolve_for_backend_start()/find_catalog_entry().
    """

    def ids_from(path: Path) -> list[str]:
        try:
            doc = load_catalog(path)
        except SparkCtlError:
            return []
        return sorted(doc["models"].keys())

    return ids_from(ETC_MODELS_FILE), ids_from(ETC_EXPERIMENTAL_FILE)


def find_catalog_entry(model_id: str) -> tuple[dict[str, Any] | None, bool]:
    """Look up `model_id` in models.yaml, then experimental.yaml if present.

    Returns (config, is_experimental) or (None, False) if not found in either.
    Raises SparkCtlError if a catalog file that exists cannot be parsed.
    """
    main_doc = load_catalog(ETC_MODELS_FILE)
    main_models = main_doc["models"]
    if model_id in main_models:
        return main_models[model_id], False
    if ETC_EXPERIMENTAL_FILE.exists():
        exp_doc = load_catalog(ETC_EXPERIMENTAL_FILE)
        exp_models = exp_doc["models"]
        if model_id in exp_models:
            return exp_models[model_id], True
    return None, False


def validate_served_name(name: Any, model_id: str) -> str:
    if not isinstance(name, str) or not SERVED_NAME_RE.match(name):
        raise CatalogError(
            f"model '{model_id}': served_model_name {name!r} is missing or unsafe "
            f"(must match {SERVED_NAME_RE.pattern})"
        )
    return name


def validate_args_tokens(raw_args: Any, model_id: str) -> list[str]:
    """Validate catalog `args:` — the only place free-form backend CLI flags
    originate. Rejects (CatalogError, exit 3) anything that could smuggle a
    volume/mount flag or a non-scalar (structured) element.
    """
    if raw_args is None:
        return []
    if not isinstance(raw_args, list):
        raise CatalogError(f"model '{model_id}': catalog 'args' must be a list")
    tokens: list[str] = []
    for item in raw_args:
        if isinstance(item, (dict, list)):
            raise CatalogError(
                f"model '{model_id}': catalog 'args' entries must be scalars; "
                f"found a nested structure ({item!r})"
            )
        token = str(item)
        if "\n" in token or "\x00" in token:
            raise CatalogError(f"model '{model_id}': catalog arg contains a forbidden control character")
        for forbidden in FORBIDDEN_ARG_PREFIXES:
            if token.startswith(forbidden):
                raise CatalogError(
                    f"model '{model_id}': catalog arg '{token}' is forbidden "
                    f"(matches disallowed prefix '{forbidden}')"
                )
        tokens.append(token)
    return tokens


def validate_environment(raw_env: Any, model_id: str) -> dict[str, str]:
    """Validate catalog `environment:` against the fixed allowlist
    {HF_HUB_OFFLINE, VLLM_*, SGLANG_*} (docs/CONTRACTS.md §5)."""
    if not raw_env:
        return {}
    if not isinstance(raw_env, dict):
        raise CatalogError(f"model '{model_id}': catalog 'environment' must be a mapping")
    result: dict[str, str] = {}
    for raw_key, value in raw_env.items():
        key = str(raw_key)
        allowed = key in ENV_ALLOWLIST_EXACT or any(key.startswith(p) for p in ENV_ALLOWLIST_PREFIXES)
        if not allowed:
            raise CatalogError(
                f"model '{model_id}': environment key '{key}' is not in the allowlist "
                f"(HF_HUB_OFFLINE, VLLM_*, SGLANG_*)"
            )
        if isinstance(value, (dict, list)):
            raise CatalogError(f"model '{model_id}': environment value for '{key}' must be a scalar")
        result[key] = str(value)
    return result


def build_vllm_argv(cfg: dict[str, Any], served_name: str) -> list[str]:
    source = cfg.get("source") or {}
    hf_repo = source.get("hf_repo")
    local_path = source.get("local_path")
    port = str(BACKEND_CONTAINER_PORT["vllm"])
    if hf_repo:
        if not isinstance(hf_repo, str) or not HF_REPO_RE.match(hf_repo):
            raise CatalogError(f"source.hf_repo {hf_repo!r} is not a safe 'org/repo' identifier")
        model_arg = hf_repo
    elif local_path:
        name = Path(str(local_path)).name
        if not name or not SAFE_BASENAME_RE.match(name):
            raise CatalogError(f"source.local_path {local_path!r} does not resolve to a safe filename")
        model_arg = f"{VLLM_LOCAL_MODEL_PREFIX}/{name}"
    else:
        raise CatalogError("vllm model catalog entry needs source.hf_repo or source.local_path")
    return [
        "vllm", "serve", model_arg,
        "--host", "0.0.0.0",
        "--port", port,
        "--served-model-name", served_name,
    ]


def build_sglang_argv(cfg: dict[str, Any], served_name: str) -> list[str]:
    source = cfg.get("source") or {}
    hf_repo = source.get("hf_repo")
    if not isinstance(hf_repo, str) or not HF_REPO_RE.match(hf_repo):
        raise CatalogError(f"sglang model catalog entry needs a safe source.hf_repo (got {hf_repo!r})")
    port = str(BACKEND_CONTAINER_PORT["sglang"])
    return [
        "python3", "-m", "sglang.launch_server",
        "--model-path", hf_repo,
        "--host", "0.0.0.0",
        "--port", port,
        "--served-model-name", served_name,
    ]


def build_llamacpp_argv(
    cfg: dict[str, Any], served_name: str, args_tokens: list[str]
) -> tuple[list[str], list[str]]:
    """Returns (fixed_prefix_argv, remaining_catalog_args). The `--model-draft`
    marker token, if present in args_tokens, is consumed here and replaced
    with the catalog's resolved drafter path.
    """
    source = cfg.get("source") or {}
    filename = source.get("filename")
    if not filename or not SAFE_BASENAME_RE.match(str(filename)):
        raise CatalogError(f"llamacpp model catalog entry needs a safe source.filename (got {filename!r})")
    port = str(BACKEND_CONTAINER_PORT["llamacpp"])
    argv = [
        "/usr/local/bin/llama-server",
        "--model", f"{GGUF_CONTAINER_DIR}/{filename}",
        "--host", "0.0.0.0",
        "--port", port,
        "--alias", served_name,
    ]
    remaining = list(args_tokens)
    if "--model-draft" in remaining:
        drafter = source.get("drafter") or {}
        draft_filename = drafter.get("filename")
        if not draft_filename or not SAFE_BASENAME_RE.match(str(draft_filename)):
            raise CatalogError(
                "args request --model-draft but catalog defines no usable source.drafter.filename"
            )
        argv += ["--model-draft", f"{GGUF_CONTAINER_DIR}/{draft_filename}"]
        remaining = [t for t in remaining if t != "--model-draft"]
    return argv, remaining


def build_backend_argv(
    cfg: dict[str, Any], backend: str, served_name: str
) -> list[str]:
    """Full command argv for `backend`: hardcoded prefix + validated catalog args."""
    args_tokens = validate_args_tokens(cfg.get("args"), served_name)
    if backend == "vllm":
        return build_vllm_argv(cfg, served_name) + args_tokens
    if backend == "sglang":
        return build_sglang_argv(cfg, served_name) + args_tokens
    if backend == "llamacpp":
        prefix, remaining = build_llamacpp_argv(cfg, served_name, args_tokens)
        return prefix + remaining
    raise CatalogError(f"unsupported backend '{backend}'")


def resolve_for_backend_start(model_id: str, experimental_flag: bool):
    """Resolve + gate a model-id for `backend-start` specifically.

    Unlike find_catalog_entry() (used for re-rendering already-active models),
    this enforces the --experimental gate and the supported-backend list.
    """
    cfg, is_experimental = find_catalog_entry(model_id)
    if cfg is None:
        hint = " or experimental.yaml" if ETC_EXPERIMENTAL_FILE.exists() else ""
        raise SparkCtlError(f"unknown model '{model_id}' (not found in models.yaml{hint})")
    if is_experimental and not experimental_flag:
        raise SparkCtlError(f"model '{model_id}' is experimental-tier; retry with --experimental")
    backend = cfg.get("backend")
    slot = cfg.get("slot")
    served_name = validate_served_name(cfg.get("served_model_name"), model_id)
    if slot not in SLOT_HOST_PORT:
        raise SparkCtlError(f"model '{model_id}' declares invalid slot {slot!r} (must be 'primary' or 'secondary')")
    if backend not in SUPPORTED_BACKENDS:
        raise SparkCtlError(
            f"backend {backend!r} for model '{model_id}' is not managed by "
            "'spark-ai-ctl backend-start'; it runs under its own systemd unit "
            "outside the docker compose stack (see docs/CONTRACTS.md §7)"
        )
    return cfg, backend, slot, served_name


# --------------------------------------------------------------------------
# active.json (authoritative active-model state; written only by this program)
# --------------------------------------------------------------------------


def load_active() -> dict[str, Any]:
    if not ACTIVE_JSON_FILE.exists():
        return {"active": {}, "updated": now_iso()}
    try:
        data = json.loads(ACTIVE_JSON_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as exc:
        raise SparkCtlError(f"{ACTIVE_JSON_FILE} is corrupt: {exc}") from exc
    if not isinstance(data, dict):
        raise SparkCtlError(f"{ACTIVE_JSON_FILE} is corrupt: expected a JSON object")
    data.setdefault("active", {})
    data.setdefault("updated", now_iso())
    return data


def save_active(data: dict[str, Any]) -> None:
    ensure_dir(VAR_LIB_ROOT, 0o755)
    data["updated"] = now_iso()
    atomic_write(ACTIVE_JSON_FILE, json.dumps(data, indent=2, sort_keys=True) + "\n", 0o644)


# --------------------------------------------------------------------------
# Rendering: /run/spark-ai-stack/override.yaml and litellm-config.yaml
# --------------------------------------------------------------------------


def render_override(active: dict[str, Any]) -> None:
    """Rebuild the compose override from active.json alone (idempotent, and the
    only author of this file). Only ever sets services.<backend>.command,
    services.<backend>.ports, and an allowlisted services.<backend>.environment
    — the full extent permitted by docs/CONTRACTS.md §2.4.
    """
    services: dict[str, Any] = {}
    for model_id, rec in active["active"].items():
        backend = rec.get("backend")
        if backend not in SUPPORTED_BACKENDS:
            # Experimental native backends (ds4, llamacpp-fork) are never
            # represented in the compose override; they run under their own
            # systemd units and are simply skipped here.
            continue
        cfg, _ = find_catalog_entry(model_id)
        if cfg is None:
            print(
                f"spark-ai-ctl: warning: active model '{model_id}' no longer resolves "
                "in the root catalog; leaving its override entry out (it may already "
                "be running from a previous render)",
                file=sys.stderr,
            )
            continue
        served_name = rec.get("served_model_name") or validate_served_name(
            cfg.get("served_model_name"), model_id
        )
        args_tokens = validate_args_tokens(cfg.get("args"), model_id)
        env_vars = validate_environment(cfg.get("environment"), model_id)
        service = rec.get("service") or service_for(backend, rec.get("slot", "primary"))
        if backend == "llamacpp":
            prefix, remaining = build_llamacpp_argv(cfg, served_name, args_tokens)
            command = prefix + remaining
        elif backend == "vllm":
            command = build_vllm_argv(cfg, served_name) + args_tokens
        else:
            command = build_sglang_argv(cfg, served_name) + args_tokens
        entry: dict[str, Any] = {
            "command": command,
            "ports": [f"127.0.0.1:{rec['port']}:{BACKEND_CONTAINER_PORT[backend]}"],
        }
        if env_vars:
            entry["environment"] = env_vars
        services[service] = entry

    header = (
        "# Rendered by spark-ai-ctl. Do not edit by hand; regenerated on every\n"
        "# backend-start / backend-stop from /var/lib/spark-ai-stack/active.json.\n"
    )
    body = yaml.safe_dump({"services": services}, sort_keys=False, default_flow_style=False)
    atomic_write(OVERRIDE_FILE, header + body, 0o644)


def render_litellm_config(active: dict[str, Any]) -> None:
    """Rebuild /run/spark-ai-stack/litellm-config.yaml from the root-owned
    template plus active.json. The master key is always referenced via
    os.environ/LITELLM_MASTER_KEY, never inlined as a literal.
    """
    if not ETC_LITELLM_TEMPLATE.exists():
        raise SparkCtlError(
            f"litellm template missing: {ETC_LITELLM_TEMPLATE} (run 'sudo spark-ai-ctl sync' first)"
        )
    try:
        with ETC_LITELLM_TEMPLATE.open("r", encoding="utf-8") as handle:
            template = yaml.safe_load(handle) or {}
    except yaml.YAMLError as exc:
        raise SparkCtlError(f"failed to parse litellm template: {exc}") from exc
    if not isinstance(template, dict):
        raise SparkCtlError(f"{ETC_LITELLM_TEMPLATE} must be a YAML mapping")

    doc = copy.deepcopy(template)
    model_list: list[dict[str, Any]] = []
    primary_params: dict[str, Any] | None = None
    for model_id, rec in sorted(active["active"].items()):
        params = {
            "model": f"openai/{rec['served_model_name']}",
            "api_base": f"http://host.docker.internal:{rec['port']}/v1",
            "api_key": "none",
        }
        model_list.append({"model_name": model_id, "litellm_params": params})
        if rec.get("slot") == "primary":
            primary_params = params
    if primary_params is not None:
        model_list.append({"model_name": "local/default", "litellm_params": dict(primary_params)})

    doc["model_list"] = model_list
    doc.setdefault("general_settings", {})
    if not isinstance(doc["general_settings"], dict):
        doc["general_settings"] = {}
    doc["general_settings"]["master_key"] = "os.environ/LITELLM_MASTER_KEY"

    header = (
        "# Rendered by spark-ai-ctl. Do not edit by hand; regenerated on every\n"
        "# gateway-reload / backend-start / backend-stop.\n"
    )
    body = yaml.safe_dump(doc, sort_keys=False, default_flow_style=False)
    atomic_write(LITELLM_RUNTIME_CONFIG, header + body, 0o644)


