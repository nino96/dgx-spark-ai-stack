def render_secrets_file(values: dict[str, str]) -> str:
    lines = [SECRETS_HEADER.rstrip("\n")]
    for key in SECRET_KEYS:
        if key == "HF_TOKEN":
            lines.append(
                "# HF_TOKEN: your Hugging Face access token "
                "(https://huggingface.co/settings/tokens)."
            )
            lines.append(
                "# Left empty by secrets-init; set it by hand, then re-run "
                "secrets-init or sync to re-derive env.d."
            )
        lines.append(f"{key}={values.get(key, '')}")
    return "\n".join(lines) + "\n"


def derive_env_d(values: dict[str, str]) -> None:
    """Derive /etc/spark-ai-stack/env.d/<service>.env per the docs/CONTRACTS.md
    §6 exposure table. Idempotent; called from secrets-init, secrets-rotate,
    and sync.
    """
    ensure_dir(ETC_ENVD_DIR, 0o755)
    litellm_master = values.get("LITELLM_MASTER_KEY", "")
    postgres_password = values.get("POSTGRES_PASSWORD", "")
    webui_secret = values.get("WEBUI_SECRET_KEY", "")
    searxng_secret = values.get("SEARXNG_SECRET", "")
    hf_token = values.get("HF_TOKEN", "")

    atomic_write(
        ETC_ENVD_DIR / "litellm.env",
        f"LITELLM_MASTER_KEY={litellm_master}\n"
        f"DATABASE_URL=postgresql://litellm:{postgres_password}@postgres:5432/litellm\n",
        0o600,
    )
    atomic_write(
        ETC_ENVD_DIR / "openwebui.env",
        f"WEBUI_SECRET_KEY={webui_secret}\n"
        f"OPENAI_API_KEY={litellm_master}\n"
        "OPENAI_API_BASE_URL=http://litellm:4000/v1\n",
        0o600,
    )
    atomic_write(ETC_ENVD_DIR / "searxng.env", f"SEARXNG_SECRET={searxng_secret}\n", 0o600)
    atomic_write(
        ETC_ENVD_DIR / "grafana.env",
        f"GF_SECURITY_ADMIN_PASSWORD={values.get('GRAFANA_ADMIN_PASSWORD', '')}\n",
        0o600,
    )

    backend_env = f"HF_TOKEN={hf_token}\nHF_HOME=/data/hf\n"
    for name in ("vllm", "llamacpp", "sglang"):
        atomic_write(ETC_ENVD_DIR / f"{name}.env", backend_env, 0o600)

    # Raw single-line value for compose `secrets:` file-source consumption
    # (POSTGRES_PASSWORD_FILE), never an env_file.
    atomic_write(ETC_ENVD_DIR / "postgres_password", f"{postgres_password}\n", 0o600)


def cmd_secrets_init(args: argparse.Namespace) -> int:
    """Create secrets.env if missing, or complete any missing keys in place.
    Never overwrites an existing non-empty value. Always re-derives env.d."""
    with state_lock():
        ensure_dir(ETC_ROOT, 0o755)
        existing = parse_env_file(SECRETS_FILE)
        values: dict[str, str] = {}
        report: list[tuple[str, str]] = []
        for key in SECRET_KEYS:
            current = existing.get(key, "").strip()
            if current:
                values[key] = current
                report.append((key, "kept"))
            elif key == "HF_TOKEN":
                values[key] = ""
                report.append((key, "left empty"))
            else:
                values[key] = secrets.token_hex(32)
                report.append((key, "generated"))
        atomic_write(SECRETS_FILE, render_secrets_file(values), 0o600)
        derive_env_d(values)
    print(f"secrets-init: {SECRETS_FILE} ready")
    for key, action in report:
        print(f"  {key:<20} {action}")
    return 0


def cmd_secrets_status(args: argparse.Namespace) -> int:
    """Print key names + set/unset + length only. NEVER prints values."""
    if not SECRETS_FILE.exists():
        print(
            f"secrets-status: {SECRETS_FILE} does not exist; run 'sudo spark-ai-ctl secrets-init'",
            file=sys.stderr,
        )
    values = parse_env_file(SECRETS_FILE)
    print(f"{'KEY':<20}{'SET':<6}{'LENGTH':<8}")
    for key in SECRET_KEYS:
        value = values.get(key, "")
        is_set = bool(value.strip())
        print(f"{key:<20}{'yes' if is_set else 'no':<6}{len(value) if is_set else 0:<8}")
    return 0


def cmd_secrets_rotate(args: argparse.Namespace) -> int:
    """Regenerate a single secret key and re-derive env.d. HF_TOKEN is refused:
    it is an externally issued credential, not something safe to replace with
    random bytes."""
    key = args.key
    if key == "HF_TOKEN":
        print(
            "spark-ai-ctl: refusing to rotate HF_TOKEN: it is an externally issued "
            f"Hugging Face access token, not a generated secret. Edit {SECRETS_FILE} "
            "by hand, then run 'sudo spark-ai-ctl secrets-init' or 'sync' to re-derive env.d.",
            file=sys.stderr,
        )
        return 2
    with state_lock():
        if not SECRETS_FILE.exists():
            raise SparkCtlError(f"{SECRETS_FILE} does not exist; run 'secrets-init' first")
        values = parse_env_file(SECRETS_FILE)
        for existing_key in SECRET_KEYS:
            values.setdefault(existing_key, "")
        values[key] = secrets.token_hex(32)
        atomic_write(SECRETS_FILE, render_secrets_file(values), 0o600)
        derive_env_d(values)
    print(f"secrets-rotate: {key} regenerated; env.d/*.env re-derived")
    return 0


