[Unit]
Description=spark-ai-stack DS4 DeepSeek V4 Flash backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DS4_CONT_MTP_MODE=2
Environment=DS4_CONT_DSPARK=1
Environment=DS4_DSPARK_MODEL=%h/ai-data/models/gguf/DSpark-drafter-Q2K-Q8-0731.gguf
ExecStart=%h/ai-data/src/ds4/ds4-server --cuda -m %h/ai-data/models/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf -c 69632 --host 127.0.0.1 --port 8003
Restart=on-failure
RestartSec=10
TimeoutStopSec=180

[Install]
WantedBy=default.target
