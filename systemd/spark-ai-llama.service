[Unit]
Description=spark-ai-stack llama.cpp Qwen3.5 4B backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/ai-data/builds/llama.cpp/bin/llama-server --model %h/ai-data/models/gguf/Qwen_Qwen3.5-4B-Q4_K_M.gguf --host 127.0.0.1 --port 8002 --ctx-size 32768 --n-gpu-layers 999 --jinja
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=default.target
