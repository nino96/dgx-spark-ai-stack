[Unit]
Description=spark-ai-stack core services (litellm, openwebui, postgres, searxng)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/spark-ai-ctl core-up
ExecStop=/usr/local/sbin/spark-ai-ctl core-down
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
