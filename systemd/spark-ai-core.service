[Unit]
Description=spark-ai-stack gateway, UI, database, and search
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/spark-ai-stack core-up
ExecStop=%h/.local/bin/spark-ai-stack core-down
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=180

[Install]
WantedBy=default.target
